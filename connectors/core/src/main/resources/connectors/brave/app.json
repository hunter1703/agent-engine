{
  "connector": {
    "auth": {
      "TOKEN": {
        "type": "HEADER",
        "headers": {
          "x-subscription-token": "{{ auth.input.token }}"
        }
      }
    }
  },
  "connection": {
    "authConfigs": {
      "TOKEN": {}
    },
    "schema": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "The API token for the Brave Web Search API.",
          "sensitive": true
        }
      },
      "required": [
        "token"
      ]
    }
  }
}
