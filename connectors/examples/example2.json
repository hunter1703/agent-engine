{
  "id": "create-github-issue",
  "appName": "github",
  "endpoint": {
    "method": "POST",
    "baseUrlTemplate": "https://api.github.com",
    "pathTemplate": "/repos/{{ vars.owner }}/{{ vars.repo }}/issues"
  },
  "headers": {
    "Accept": "application/vnd.github.v3+json",
    "User-Agent": "AgentEngine"
  },
  "auth": {
    "type": "BEARER_TOKEN",
    "bearerToken": "{{ auth.githubToken }}"
  },
  "body": {
    "type": "JSON",
    "template": {
      "title": "{{ input.issueTitle }}",
      "body": {
        "$optional": "input.issueBody"
      },
      "labels": {
        "$optional": "input.labels"
      }
    },
    "omitNulls": true
  },
  "responseMapping": {
    "resultPath": "$"
  }
}
