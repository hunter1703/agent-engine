{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response Done Event Schema",
  "description": "Schema for the response.done event in the Codex Responses API",
  "type": "object",
  "properties": {
    "type": {
      "const": "response.done"
    },
    "response": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the response"
        },
        "status": {
          "type": "string",
          "description": "Final status of the response"
        },
        "object": {
          "const": "response",
          "description": "Object type identifier"
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of input tokens used"
            },
            "input_tokens_details": {
              "type": "object",
              "properties": {
                "cached_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of cached input tokens"
                }
              },
              "required": ["cached_tokens"]
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of output tokens generated"
            },
            "output_tokens_details": {
              "type": "object",
              "properties": {
                "reasoning_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of reasoning tokens"
                }
              },
              "required": ["reasoning_tokens"]
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Total number of tokens used"
            }
          },
          "required": ["input_tokens", "output_tokens", "total_tokens"],
          "examples": [
            {
              "input_tokens": 10,
              "input_tokens_details": {
                "cached_tokens": 5
              },
              "output_tokens": 20,
              "output_tokens_details": {
                "reasoning_tokens": 15
              },
              "total_tokens": 30
            }
          ]
        }
      },
      "examples": [
        {
          "id": "resp_jkl012",
          "status": "completed",
          "object": "response",
          "usage": {
            "input_tokens": 10,
            "output_tokens": 20,
            "total_tokens": 30
          }
        }
      ]
    }
  },
  "required": ["type"],
  "examples": [
    {
      "type": "response.done",
      "response": {
        "id": "resp_jkl012",
        "status": "completed",
        "object": "response",
        "usage": {
          "input_tokens": 10,
          "output_tokens": 20,
          "total_tokens": 30
        }
      }
    }
  ]
}