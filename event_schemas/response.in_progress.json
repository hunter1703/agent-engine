{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response In Progress Event Schema",
  "description": "Schema for the response.in_progress event in the Codex Responses API",
  "type": "object",
  "properties": {
    "type": {
      "const": "response.in_progress"
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Current status of the response"
        }
      },
      "required": ["status"],
      "examples": [
        {
          "status": "in_progress"
        }
      ]
    }
  },
  "required": ["type", "response"],
  "examples": [
    {
      "type": "response.in_progress",
      "response": {
        "status": "in_progress"
      }
    }
  ]
}