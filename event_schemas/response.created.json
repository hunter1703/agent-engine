{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response Created Event Schema",
  "description": "Schema for the response.created event in the Codex Responses API",
  "type": "object",
  "properties": {
    "type": {
      "const": "response.created"
    },
    "response": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the response"
        },
        "model": {
          "type": "string",
          "description": "The model used for the response"
        },
        "status": {
          "type": "string",
          "description": "Current status of the response"
        },
        "object": {
          "const": "response",
          "description": "Object type identifier"
        },
        "created": {
          "type": "integer",
          "description": "Unix timestamp of when the response was created"
        }
      },
      "required": ["id", "model", "status", "object"],
      "examples": [
        {
          "id": "resp_abc123",
          "model": "shell_agent",
          "status": "in_progress",
          "object": "response",
          "created": 1770126672
        }
      ]
    }
  },
  "required": ["type", "response"],
  "examples": [
    {
      "type": "response.created",
      "response": {
        "id": "resp_abc123",
        "model": "shell_agent",
        "status": "in_progress",
        "object": "response",
        "created": 1770126672
      }
    }
  ]
}