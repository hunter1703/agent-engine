{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response Failed Event Schema",
  "description": "Schema for the response.failed event in the Codex Responses API",
  "type": "object",
  "properties": {
    "type": {
      "const": "response.failed"
    },
    "response": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the response"
        },
        "object": {
          "const": "response",
          "description": "Object type identifier"
        },
        "created_at": {
          "type": "integer",
          "description": "Unix timestamp of when the response was created"
        },
        "status": {
          "const": "failed",
          "description": "Status indicating the response failed"
        },
        "background": {
          "type": "boolean",
          "description": "Whether the response was running in the background"
        },
        "error": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "Type of error"
            },
            "code": {
              "type": "string",
              "description": "Error code"
            },
            "message": {
              "type": "string",
              "description": "Error message"
            },
            "plan_type": {
              "type": "string",
              "description": "Plan type associated with the error"
            },
            "resets_at": {
              "type": "integer",
              "description": "Unix timestamp when the rate limit resets"
            }
          },
          "examples": [
            {
              "type": "error",
              "code": "context_length_exceeded",
              "message": "Your input exceeds the context window of this model. Please adjust your input and try again.",
              "plan_type": "free"
            }
          ]
        }
      },
      "required": ["id", "object", "status", "background", "error"],
      "examples": [
        {
          "id": "resp_def456",
          "object": "response",
          "created_at": 1770126673,
          "status": "failed",
          "background": false,
          "error": {
            "type": "error",
            "code": "context_length_exceeded",
            "message": "Your input exceeds the context window of this model. Please adjust your input and try again."
          }
        }
      ]
    }
  },
  "required": ["type", "response"],
  "examples": [
    {
      "type": "response.failed",
      "response": {
        "id": "resp_def456",
        "object": "response",
        "created_at": 1770126673,
        "status": "failed",
        "background": false,
        "error": {
          "type": "error",
          "code": "context_length_exceeded",
          "message": "Your input exceeds the context window of this model. Please adjust your input and try again."
        }
      }
    }
  ]
}