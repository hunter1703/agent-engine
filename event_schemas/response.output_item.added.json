{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response Output Item Added Event Schema",
  "description": "Schema for the response.output_item.added event in the Codex Responses API",
  "type": "object",
  "properties": {
    "type": {
      "const": "response.output_item.added"
    },
    "item": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "message"
            },
            "role": {
              "type": "string",
              "enum": ["user", "assistant", "system"]
            },
            "content": {
              "type": "array",
              "items": {
                "type": "object",
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "input_text"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": ["type", "text"],
                    "examples": [
                      {
                        "type": "input_text",
                        "text": "Hello, world!"
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "input_image"
                      },
                      "image": {
                        "type": "string"
                      }
                    },
                    "required": ["type", "image"],
                    "examples": [
                      {
                        "type": "input_image",
                        "image": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg=="
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "output_text"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": ["type", "text"],
                    "examples": [
                      {
                        "type": "output_text",
                        "text": "Hello! How can I assist you today?"
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "image"
                      },
                      "image": {
                        "type": "string"
                      }
                    },
                    "required": ["type", "image"],
                    "examples": [
                      {
                        "type": "image",
                        "image": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg=="
                      }
                    ]
                  }
                ]
              }
            }
          },
          "required": ["type", "role", "content"],
          "examples": [
            {
              "type": "message",
              "role": "assistant",
              "content": [
                {
                  "type": "output_text",
                  "text": "Hello! How can I assist you today?"
                }
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "function_call"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "arguments": {
              "type": "string"
            }
          },
          "required": ["type", "id", "name", "arguments"],
          "examples": [
            {
              "type": "function_call",
              "id": "call_abc123",
              "name": "get_current_weather",
              "arguments": "{\\"location\\": \\"San Francisco, CA\\", \\"unit\\": \\"celsius\\"}"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "function_call_output"
            },
            "call_id": {
              "type": "string"
            },
            "output": {
              "type": "string"
            }
          },
          "required": ["type", "call_id", "output"],
          "examples": [
            {
              "type": "function_call_output",
              "call_id": "call_abc123",
              "output": "72 degrees, sunny"
            }
          ]
        }
      ]
    },
    "output_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Index of the output item in the sequence"
    }
  },
  "required": ["type", "item"],
  "examples": [
    {
      "type": "response.output_item.added",
      "item": {
        "type": "message",
        "role": "assistant",
        "content": [
          {
            "type": "output_text",
            "text": "Hello! How can I assist you today?"
          }
        ]
      },
      "output_index": 0
    }
  ]
}