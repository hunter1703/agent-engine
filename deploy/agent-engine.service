[Unit]
Description=Agent Engine REST Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/agent-engine
Environment=PLUGIN_DIR=/opt/agent-engine/plugins
ExecStart=/usr/bin/java -jar /opt/agent-engine/quarkus-run.jar
Restart=on-failure
User=agent
Group=agent

[Install]
WantedBy=multi-user.target
