+package com.agentengine.interfaces.local.vault.repository;
+
+import static com.mongodb.client.model.Filters.eq;
+
+import com.agentengine.engine.repository.AbstractMongoRepository;
+import com.agentengine.engine.repository.MongoClientFactory;
+import com.agentengine.interfaces.local.vault.entities.VaultPushReceiptEntity;
+import jakarta.inject.Singleton;
+import java.util.Optional;
+
+@Singleton
+public class VaultPushReceiptRepository extends AbstractMongoRepository<VaultPushReceiptEntity> {
+
+  public VaultPushReceiptRepository(final MongoClientFactory mongoClientFactory) {
+    super(mongoClientFactory, "VAULT_PUSH_RECEIPT", VaultPushReceiptEntity.class);
+  }
+
+  public Optional<VaultPushReceiptEntity> findByIdempotencyKey(final String idempotencyKey) {
+    return Optional.ofNullable(getCollection().find(eq("idempotencyKey", idempotencyKey)).first());
+  }
+}
diff --git a/interfaces/local/src/main/java/com/agentengine/interfaces/local/vault/service/VaultService.java b/interfaces/local/src/main/java/com/agentengine/interfaces/local/vault/service/VaultService.java
