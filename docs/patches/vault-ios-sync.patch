+package com.agentengine.interfaces.local.vault.repository;
+
+import static com.mongodb.client.model.Filters.and;
+import static com.mongodb.client.model.Filters.eq;
+import static com.mongodb.client.model.Filters.gt;
+
+import com.agentengine.engine.repository.AbstractMongoRepository;
+import com.agentengine.engine.repository.MongoClientFactory;
+import com.agentengine.interfaces.local.vault.entities.VaultCiphertextEntity;
+import com.mongodb.client.model.Sorts;
+import jakarta.inject.Singleton;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+
+@Singleton
+public class VaultCiphertextRepository extends AbstractMongoRepository<VaultCiphertextEntity> {
+
+  public VaultCiphertextRepository(final MongoClientFactory mongoClientFactory) {
+    super(mongoClientFactory, "VAULT_CIPHERTEXT", VaultCiphertextEntity.class);
+  }
+
+  public List<VaultCiphertextEntity> findByDeviceId(final String deviceId, final int offset, final int limit) {
+    final List<VaultCiphertextEntity> result = new ArrayList<>();
+    for (VaultCiphertextEntity entity :
+        getCollection()
+            .find(eq("deviceId", deviceId))
+            .sort(Sorts.descending("updatedTime"))
+            .skip(offset)
+            .limit(limit)) {
+      result.add(entity);
+    }
+    return result;
+  }
+
+  public List<VaultCiphertextEntity> findUpdatedAfter(
+      final String deviceId, final long updatedAfter, final int limit) {
+    final List<VaultCiphertextEntity> result = new ArrayList<>();
+    for (VaultCiphertextEntity entity :
+        getCollection()
+            .find(and(eq("deviceId", deviceId), gt("updatedTime", updatedAfter)))
+            .sort(Sorts.ascending("updatedTime"))
+            .limit(limit)) {
+      result.add(entity);
+    }
+    return result;
+  }
+
+  public Optional<VaultCiphertextEntity> findByIdAndDeviceId(final String id, final String deviceId) {
+    return Optional.ofNullable(getCollection().find(and(eq("_id", id), eq("deviceId", deviceId))).first());
+  }
+}
