+package com.agentengine.interfaces.local.vault.service;
+
+public class VaultServiceException extends RuntimeException {
+
+  private final int status;
+
+  public VaultServiceException(final String message, final int status) {
+    super(message);
+    this.status = status;
+  }
+
+  public int getStatus() {
+    return status;
+  }
+}
