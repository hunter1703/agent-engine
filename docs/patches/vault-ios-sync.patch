+package com.agentengine.interfaces.local.vault.service;
+
+import com.agentengine.engine.api.utils.HashUtils;
+import com.agentengine.engine.api.utils.StringUtils;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.CiphertextItemRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.CiphertextItemResponse;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.CiphertextManifestItem;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.KeyBootstrapRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.KeyFetchRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.ManifestListRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.ManifestListResponse;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.SyncPullRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.SyncPullResponse;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.SyncPushRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.SyncPushResponse;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.WrappedKeyEnvelopeResponse;
+import com.agentengine.interfaces.local.vault.entities.VaultCiphertextEntity;
+import com.agentengine.interfaces.local.vault.entities.VaultKeyEnvelopeEntity;
+import com.agentengine.interfaces.local.vault.entities.VaultPushReceiptEntity;
+import com.agentengine.interfaces.local.vault.repository.VaultCiphertextRepository;
+import com.agentengine.interfaces.local.vault.repository.VaultKeyEnvelopeRepository;
+import com.agentengine.interfaces.local.vault.repository.VaultPushReceiptRepository;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import java.util.Base64;
+import java.util.List;
+import java.util.Optional;
+import java.util.UUID;
+
+@Singleton
+public class VaultService {
+
+  private final VaultCiphertextRepository ciphertextRepository;
+  private final VaultKeyEnvelopeRepository keyEnvelopeRepository;
+  private final VaultPushReceiptRepository pushReceiptRepository;
+
+  @Inject
+  public VaultService(
+      final VaultCiphertextRepository ciphertextRepository,
+      final VaultKeyEnvelopeRepository keyEnvelopeRepository,
+      final VaultPushReceiptRepository pushReceiptRepository) {
+    this.ciphertextRepository = ciphertextRepository;
+    this.keyEnvelopeRepository = keyEnvelopeRepository;
+    this.pushReceiptRepository = pushReceiptRepository;
+  }
+
+  public WrappedKeyEnvelopeResponse bootstrapKey(final KeyBootstrapRequest request) {
+    final Optional<VaultKeyEnvelopeEntity> existing =
+        keyEnvelopeRepository.findByDeviceId(request.getDeviceId());
+    if (existing.isPresent()) {
+      final VaultKeyEnvelopeEntity entity = existing.get();
+      if (StringUtils.isNotBlank(request.getPinProof())) {
+        entity.setPinProofHash(HashUtils.HMACSHA256_Base64(request.getPinProof()));
+        entity.setUpdatedTime(now());
+        keyEnvelopeRepository.save(entity);
+      }
+      return toEnvelopeResponse(entity);
+    }
+
+    final VaultKeyEnvelopeEntity entity = new VaultKeyEnvelopeEntity();
+    entity.setId(UUID.randomUUID().toString());
+    entity.setDeviceId(request.getDeviceId());
+    entity.setKeyId(UUID.randomUUID().toString());
+    entity.setWrappedMasterKey(randomWrappedKey());
+    entity.setPinProofHash(HashUtils.HMACSHA256_Base64(request.getPinProof()));
+    entity.setCreatedTime(now());
+    entity.setUpdatedTime(now());
+    keyEnvelopeRepository.insert(entity);
+
+    return toEnvelopeResponse(entity);
+  }
+
+  public WrappedKeyEnvelopeResponse fetchWrappedKeyOnce(final KeyFetchRequest request) {
+    final VaultKeyEnvelopeEntity entity =
+        keyEnvelopeRepository
+            .findByDeviceId(request.getDeviceId())
+            .orElseThrow(() -> new VaultServiceException("Key envelope not found", 404));
+
+    if (entity.getConsumedTime() != null) {
+      throw new VaultServiceException("Key already fetched once", 409);
+    }
+
+    if (StringUtils.isNotBlank(entity.getPinProofHash())) {
+      final String candidate = HashUtils.HMACSHA256_Base64(request.getPinProof());
+      if (!candidate.equals(entity.getPinProofHash())) {
+        throw new VaultServiceException("Invalid pin proof", 401);
+      }
+    }
+
+    entity.setConsumedTime(now());
+    entity.setUpdatedTime(now());
+    keyEnvelopeRepository.save(entity);
+
+    return toEnvelopeResponse(entity);
+  }
+
+  public CiphertextItemResponse upsertCiphertext(final CiphertextItemRequest request) {
+    final long now = now();
+    final String id = StringUtils.isBlank(request.getId()) ? UUID.randomUUID().toString() : request.getId();
+
+    final VaultCiphertextEntity entity =
+        ciphertextRepository
+            .findById(id)
+            .orElseGet(
+                () -> {
+                  final VaultCiphertextEntity created = new VaultCiphertextEntity();
+                  created.setId(id);
+                  created.setVersion(0L);
+                  created.setCreatedTime(now);
+                  return created;
+                });
+
+    entity.setDeviceId(request.getDeviceId());
+    entity.setType(request.getType());
+    entity.setCiphertext(request.getCiphertext());
+    entity.setNonce(request.getNonce());
+    entity.setWrappedDek(request.getWrappedDek());
+    entity.setVersion(entity.getVersion() == null ? 1L : entity.getVersion() + 1L);
+    entity.setUpdatedTime(now);
+
+    ciphertextRepository.save(entity);
+    return toCiphertextResponse(entity);
+  }
+
+  public ManifestListResponse listManifest(final ManifestListRequest request) {
+    final List<VaultCiphertextEntity> records =
+        ciphertextRepository.findByDeviceId(
+            request.getDeviceId(), request.getOffset(), request.getLimit());
+
+    final ManifestListResponse response = new ManifestListResponse();
+    response.setItems(
+        records.stream()
+            .map(
+                entity -> {
+                  final CiphertextManifestItem item = new CiphertextManifestItem();
+                  item.setId(entity.getId());
+                  item.setType(entity.getType());
+                  item.setUpdatedTime(entity.getUpdatedTime());
+                  item.setVersion(entity.getVersion());
+                  return item;
+                })
+            .toList());
+
+    return response;
+  }
+
+  public CiphertextItemResponse getCiphertext(final String id, final String deviceId) {
+    if (StringUtils.isBlank(id) || StringUtils.isBlank(deviceId)) {
+      throw new VaultServiceException("id and deviceId are required", 400);
+    }
+
+    return ciphertextRepository
+        .findByIdAndDeviceId(id, deviceId)
+        .map(this::toCiphertextResponse)
+        .orElseThrow(() -> new VaultServiceException("Ciphertext item not found", 404));
+  }
+
+  public SyncPushResponse push(final SyncPushRequest request) {
+    final Optional<VaultPushReceiptEntity> existingReceipt =
+        pushReceiptRepository.findByIdempotencyKey(request.getIdempotencyKey());
+    if (existingReceipt.isPresent()) {
+      final SyncPushResponse duplicateResponse = new SyncPushResponse();
+      duplicateResponse.setAcceptedCount(existingReceipt.get().getAcceptedCount());
+      duplicateResponse.setDuplicate(true);
+      return duplicateResponse;
+    }
+
+    int accepted = 0;
+    for (CiphertextItemRequest record : request.getRecords()) {
+      upsertCiphertext(record);
+      accepted++;
+    }
+
+    final VaultPushReceiptEntity receipt = new VaultPushReceiptEntity();
+    receipt.setId(UUID.randomUUID().toString());
+    receipt.setIdempotencyKey(request.getIdempotencyKey());
+    receipt.setAcceptedCount(accepted);
+    receipt.setCreatedTime(now());
+    receipt.setUpdatedTime(now());
+    pushReceiptRepository.insert(receipt);
+
+    final SyncPushResponse response = new SyncPushResponse();
+    response.setAcceptedCount(accepted);
+    response.setDuplicate(false);
+    return response;
+  }
+
+  public SyncPullResponse pull(final SyncPullRequest request) {
+    final long cursor = parseCursor(request.getCursor());
+    final List<VaultCiphertextEntity> records =
+        ciphertextRepository.findUpdatedAfter(request.getDeviceId(), cursor, request.getLimit());
+
+    final SyncPullResponse response = new SyncPullResponse();
+    response.setRecords(records.stream().map(this::toCiphertextResponse).toList());
+
+    final long nextCursor = records.stream().map(VaultCiphertextEntity::getUpdatedTime).max(Long::compareTo).orElse(cursor);
+    response.setCursor(String.valueOf(nextCursor));
+    return response;
+  }
+
+  private WrappedKeyEnvelopeResponse toEnvelopeResponse(final VaultKeyEnvelopeEntity entity) {
+    final WrappedKeyEnvelopeResponse response = new WrappedKeyEnvelopeResponse();
+    response.setKeyId(entity.getKeyId());
+    response.setWrappedMasterKey(entity.getWrappedMasterKey());
+    return response;
+  }
+
+  private CiphertextItemResponse toCiphertextResponse(final VaultCiphertextEntity entity) {
+    final CiphertextItemResponse response = new CiphertextItemResponse();
+    response.setId(entity.getId());
+    response.setDeviceId(entity.getDeviceId());
+    response.setType(entity.getType());
+    response.setCiphertext(entity.getCiphertext());
+    response.setNonce(entity.getNonce());
+    response.setWrappedDek(entity.getWrappedDek());
+    response.setVersion(entity.getVersion());
+    response.setUpdatedTime(entity.getUpdatedTime());
+    return response;
+  }
+
+  private String randomWrappedKey() {
+    final byte[] keyBytes = new byte[48];
+    UUID first = UUID.randomUUID();
+    UUID second = UUID.randomUUID();
+    System.arraycopy(asBytes(first), 0, keyBytes, 0, 16);
+    System.arraycopy(asBytes(second), 0, keyBytes, 16, 16);
+    System.arraycopy(asBytes(UUID.randomUUID()), 0, keyBytes, 32, 16);
+    return Base64.getEncoder().encodeToString(keyBytes);
+  }
+
+  private byte[] asBytes(final UUID uuid) {
+    final long most = uuid.getMostSignificantBits();
+    final long least = uuid.getLeastSignificantBits();
+    final byte[] result = new byte[16];
+    for (int i = 0; i < 8; i++) {
+      result[i] = (byte) (most >>> (8 * (7 - i)));
+      result[8 + i] = (byte) (least >>> (8 * (7 - i)));
+    }
+    return result;
+  }
+
+  private long parseCursor(final String cursor) {
+    if (StringUtils.isBlank(cursor)) {
+      return 0L;
+    }
+    try {
+      return Long.parseLong(cursor);
+    } catch (NumberFormatException e) {
+      throw new VaultServiceException("Invalid cursor", 400);
+    }
+  }
+
+  private long now() {
+    return System.currentTimeMillis();
+  }
+}
