+package com.agentengine.interfaces.local.vault.api;
+
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.CiphertextItemRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.CiphertextItemResponse;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.KeyBootstrapRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.KeyFetchRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.ManifestListRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.ManifestListResponse;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.SyncPullRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.SyncPullResponse;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.SyncPushRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.SyncPushResponse;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.WrappedKeyEnvelopeResponse;
+import com.agentengine.interfaces.local.vault.service.VaultService;
+import io.smallrye.common.annotation.RunOnVirtualThread;
+import jakarta.inject.Inject;
+import jakarta.validation.Valid;
+import jakarta.ws.rs.Consumes;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.POST;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.PathParam;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+import org.eclipse.microprofile.openapi.annotations.Operation;
+import org.eclipse.microprofile.openapi.annotations.tags.Tag;
+
+@Path("/v1/vault")
+@Consumes(MediaType.APPLICATION_JSON)
+@Produces(MediaType.APPLICATION_JSON)
+@Tag(name = "Vault", description = "Encrypted vault APIs for iOS clients")
+@RunOnVirtualThread
+public class VaultAPI {
+
+  private final VaultService vaultService;
+
+  @Inject
+  public VaultAPI(final VaultService vaultService) {
+    this.vaultService = vaultService;
+  }
+
+  @POST
+  @Path("/key/bootstrap")
+  @Operation(summary = "Bootstrap wrapped key envelope for a device")
+  public WrappedKeyEnvelopeResponse bootstrapKey(@Valid final KeyBootstrapRequest request) {
+    return vaultService.bootstrapKey(request);
+  }
+
+  @POST
+  @Path("/key/fetch-once")
+  @Operation(summary = "Fetch wrapped key envelope exactly once")
+  public WrappedKeyEnvelopeResponse fetchKeyOnce(@Valid final KeyFetchRequest request) {
+    return vaultService.fetchWrappedKeyOnce(request);
+  }
+
+  @POST
+  @Path("/items/upsert-ciphertext")
+  @Operation(summary = "Upsert a ciphertext item")
+  public CiphertextItemResponse upsertCiphertext(@Valid final CiphertextItemRequest request) {
+    return vaultService.upsertCiphertext(request);
+  }
+
+  @POST
+  @Path("/items/list-manifest")
+  @Operation(summary = "List ciphertext manifest for a device")
+  public ManifestListResponse listManifest(@Valid final ManifestListRequest request) {
+    return vaultService.listManifest(request);
+  }
+
+  @GET
+  @Path("/items/{id}/ciphertext")
+  @Operation(summary = "Retrieve ciphertext item by id and device")
+  public CiphertextItemResponse getCiphertext(
+      @PathParam("id") final String id, @QueryParam("deviceId") final String deviceId) {
+    return vaultService.getCiphertext(id, deviceId);
+  }
+
+  @POST
+  @Path("/sync/push")
+  @Operation(summary = "Push ciphertext records with idempotency key")
+  public SyncPushResponse push(@Valid final SyncPushRequest request) {
+    return vaultService.push(request);
+  }
+
+  @POST
+  @Path("/sync/pull")
+  @Operation(summary = "Pull ciphertext records since cursor")
+  public SyncPullResponse pull(@Valid final SyncPullRequest request) {
+    return vaultService.pull(request);
+  }
+}
