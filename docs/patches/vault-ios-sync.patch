+package com.agentengine.interfaces.local.vault.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.CiphertextItemRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.KeyBootstrapRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.KeyFetchRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.SyncPushRequest;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.SyncPushResponse;
+import com.agentengine.interfaces.local.vault.dto.VaultDtos.WrappedKeyEnvelopeResponse;
+import com.agentengine.interfaces.local.vault.entities.VaultCiphertextEntity;
+import com.agentengine.interfaces.local.vault.entities.VaultKeyEnvelopeEntity;
+import com.agentengine.interfaces.local.vault.entities.VaultPushReceiptEntity;
+import com.agentengine.interfaces.local.vault.repository.VaultCiphertextRepository;
+import com.agentengine.interfaces.local.vault.repository.VaultKeyEnvelopeRepository;
+import com.agentengine.interfaces.local.vault.repository.VaultPushReceiptRepository;
+import java.util.List;
+import java.util.Optional;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+class VaultServiceTest {
+
+  private VaultCiphertextRepository ciphertextRepository;
+  private VaultKeyEnvelopeRepository keyEnvelopeRepository;
+  private VaultPushReceiptRepository pushReceiptRepository;
+  private VaultService vaultService;
+
+  @BeforeEach
+  void setUp() {
+    ciphertextRepository = Mockito.mock(VaultCiphertextRepository.class);
+    keyEnvelopeRepository = Mockito.mock(VaultKeyEnvelopeRepository.class);
+    pushReceiptRepository = Mockito.mock(VaultPushReceiptRepository.class);
+    vaultService =
+        new VaultService(ciphertextRepository, keyEnvelopeRepository, pushReceiptRepository);
+  }
+
+  @Test
+  void bootstrapCreatesEnvelopeWhenMissing() {
+    when(keyEnvelopeRepository.findByDeviceId("device-1")).thenReturn(Optional.empty());
+
+    final KeyBootstrapRequest request = new KeyBootstrapRequest();
+    request.setDeviceId("device-1");
+    request.setPinProof("proof");
+
+    final WrappedKeyEnvelopeResponse response = vaultService.bootstrapKey(request);
+
+    assertThat(response.getKeyId()).isNotBlank();
+    assertThat(response.getWrappedMasterKey()).isNotBlank();
+    verify(keyEnvelopeRepository).insert(any(VaultKeyEnvelopeEntity.class));
+  }
+
+  @Test
+  void fetchOnceRejectsSecondFetch() {
+    final VaultKeyEnvelopeEntity entity = new VaultKeyEnvelopeEntity();
+    entity.setDeviceId("device-1");
+    entity.setKeyId("key");
+    entity.setWrappedMasterKey("wrapped");
+    entity.setConsumedTime(System.currentTimeMillis());
+
+    when(keyEnvelopeRepository.findByDeviceId("device-1")).thenReturn(Optional.of(entity));
+
+    final KeyFetchRequest request = new KeyFetchRequest();
+    request.setDeviceId("device-1");
+    request.setPinProof("proof");
+
+    assertThatThrownBy(() -> vaultService.fetchWrappedKeyOnce(request))
+        .isInstanceOf(VaultServiceException.class)
+        .hasMessageContaining("already fetched once");
+  }
+
+  @Test
+  void pushReturnsDuplicateOnIdempotencyHit() {
+    final VaultPushReceiptEntity receipt = new VaultPushReceiptEntity();
+    receipt.setAcceptedCount(5);
+    when(pushReceiptRepository.findByIdempotencyKey("idem-1")).thenReturn(Optional.of(receipt));
+
+    final SyncPushRequest request = new SyncPushRequest();
+    request.setIdempotencyKey("idem-1");
+
+    final SyncPushResponse response = vaultService.push(request);
+
+    assertThat(response.isDuplicate()).isTrue();
+    assertThat(response.getAcceptedCount()).isEqualTo(5);
+  }
+
+  @Test
+  void pushUpsertsRecordsWhenNewIdempotencyKey() {
+    when(pushReceiptRepository.findByIdempotencyKey("idem-2")).thenReturn(Optional.empty());
+    when(ciphertextRepository.findById("rec-1")).thenReturn(Optional.empty());
+
+    final CiphertextItemRequest item = new CiphertextItemRequest();
+    item.setId("rec-1");
+    item.setDeviceId("device-1");
+    item.setType("image");
+    item.setCiphertext("cipher");
+    item.setNonce("nonce");
+    item.setWrappedDek("dek");
+
+    final SyncPushRequest request = new SyncPushRequest();
+    request.setIdempotencyKey("idem-2");
+    request.setRecords(List.of(item));
+
+    final SyncPushResponse response = vaultService.push(request);
+
+    assertThat(response.isDuplicate()).isFalse();
+    assertThat(response.getAcceptedCount()).isEqualTo(1);
+    verify(ciphertextRepository).save(any(VaultCiphertextEntity.class));
+    verify(pushReceiptRepository).insert(any(VaultPushReceiptEntity.class));
+  }
+}
