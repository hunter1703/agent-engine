        "widget" : "NUMBER",
        "step" : "sampling",
        "section" : "sampling",
        "order" : 60,
        "access" : {
          "create" : "EDITABLE",
          "edit" : "EDITABLE",
          "view" : "READ_ONLY"
        },
        "numberType" : "integer",
        "advanced" : true
      },
      "/model" : {
        "label" : "Model Identifier",
        "widget" : "TEXT",
        "step" : "identity",
        "section" : "identity",
        "order" : 30,
        "access" : {
          "create" : "EDITABLE",
          "edit" : "EDITABLE",
          "view" : "READ_ONLY"
