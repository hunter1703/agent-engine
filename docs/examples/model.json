{
  "schema" : {
    "$schema" : "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties" : false,
    "properties" : {
      "apiKey" : {
        "type" : "string",
        "writeOnly" : true
      },
      "baseUrl" : {
        "type" : "string"
      },
      "createdTime" : {
        "type" : "integer"
      },
      "id" : {
        "type" : "string"
      },
      "instructions" : {
        "type" : "string"
      },
      "maxContextLength" : {
        "type" : "integer"
      },
      "model" : {
        "type" : "string"
      },
      "name" : {
        "type" : "string"
      },
      "numPredict" : {
        "type" : "integer"
      },
      "repeatPenalty" : {
        "type" : "number"
      },
      "responseFormat" : {
        "type" : "string"
      },
      "serverArgs" : {
        "items" : {
          "type" : "string"
        },
        "type" : "array"
      },
      "serverCommand" : {
        "type" : "string"
      },
      "serverWorkdir" : {
        "type" : "string"
      },
      "stopTokens" : {
        "items" : {
          "type" : "string"
        },
        "type" : "array"
      },
      "temperature" : {
        "type" : "number"
      },
      "toolCallingEnabled" : {
        "default" : false,
        "type" : "boolean"
      },
      "toolCallingSupported" : {
        "default" : false,
        "type" : "boolean"
      },
      "topK" : {
        "type" : "integer"
      },
      "topP" : {
        "type" : "number"
      },
      "type" : {
        "enum" : [ "ollama", "open_ai_compatible", "gemini" ],
        "type" : "string"
      },
      "updatedTime" : {
        "type" : "integer"
      }
    },
    "required" : [ "model", "type" ],
    "type" : "object"
  },
  "layout" : {
    "fields" : {
      "/apiKey" : {
        "label" : "API Key",
        "widget" : "TEXT",
        "step" : "integration",
        "section" : "integration",
        "order" : 20,
        "access" : {
          "create" : "EDITABLE",
          "edit" : "EDITABLE",
          "view" : "READ_ONLY"
        },
        "rules" : [ {
          "effect" : "VISIBLE",
          "expr" : {
            "===" : [ {
              "var" : "type"
            }, "gemini" ]
          }
        } ],
        "sensitive" : true
      },
      "/baseUrl" : {
        "label" : "Base URL",
        "widget" : "TEXT",
        "step" : "integration",
        "section" : "integration",
        "order" : 10,
        "access" : {
          "create" : "EDITABLE",
          "edit" : "EDITABLE",
          "view" : "READ_ONLY"
        },
        "rules" : [ {
          "effect" : "VISIBLE",
          "expr" : {
            "in" : [ {
              "var" : "type"
            }, [ "ollama", "open_ai_compatible" ] ]
          }
        } ]
      },
      "/id" : {
        "label" : "ID",
        "widget" : "TEXT",
        "step" : "identity",
        "section" : "identity",
        "order" : 0,
        "access" : {
