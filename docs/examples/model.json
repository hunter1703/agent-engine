        "step" : "integration",
        "section" : "integration",
        "order" : 40,
        "access" : {
          "create" : "EDITABLE",
          "edit" : "EDITABLE",
          "view" : "READ_ONLY"
        },
        "collection" : true,
        "multiline" : true,
        "rows" : 3,
        "rules" : [ {
          "effect" : "VISIBLE",
          "expr" : {
            "===" : [ {
              "var" : "type"
            }, "open_ai_compatible" ]
          }
        } ]
      },
      "/serverCommand" : {
        "label" : "Server Command",
        "widget" : "TEXT",
        "step" : "integration",
        "section" : "integration",
        "order" : 30,
        "access" : {
          "create" : "EDITABLE",
          "edit" : "EDITABLE",
          "view" : "READ_ONLY"
        },
        "rules" : [ {
          "effect" : "VISIBLE",
          "expr" : {
            "===" : [ {
              "var" : "type"
            }, "open_ai_compatible" ]
          }
        } ]
      },
      "/serverWorkdir" : {
        "label" : "Server Working Directory",
        "widget" : "TEXT",
        "step" : "integration",
        "section" : "integration",
        "order" : 50,
        "access" : {
          "create" : "EDITABLE",
          "edit" : "EDITABLE",
          "view" : "READ_ONLY"
        },
        "rules" : [ {
          "effect" : "VISIBLE",
          "expr" : {
            "===" : [ {
              "var" : "type"
            }, "open_ai_compatible" ]
          }
        } ]
      },
      "/stopTokens" : {
        "label" : "Stop Tokens",
        "widget" : "TEXT",
        "step" : "sampling",
        "section" : "sampling",
        "order" : 70,
        "access" : {
          "create" : "EDITABLE",
          "edit" : "EDITABLE",
          "view" : "READ_ONLY"
        },
        "collection" : true,
        "advanced" : true
