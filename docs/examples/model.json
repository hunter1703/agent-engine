    "presets" : [ {
      "id" : "balanced",
      "label" : "Balanced",
      "description" : "General purpose default profile.",
      "isDefault" : true,
      "preset" : {
        "capabilities" : {
          "toolCallingEnabled" : false
        },
        "inference" : {
          "repeatPenalty" : 1.0,
          "temperature" : 0.7,
          "topP" : 0.95
        }
      }
    }, {
      "id" : "focused",
      "label" : "Focused",
      "description" : "Lower randomness for deterministic answers.",
      "isDefault" : false,
      "preset" : {
        "capabilities" : {
          "toolCallingEnabled" : true
        },
        "inference" : {
          "repeatPenalty" : 1.1,
          "temperature" : 0.2,
          "topP" : 0.8
        }
      }
    }, {
      "id" : "creative",
      "label" : "Creative",
      "description" : "Higher diversity and broader token exploration.",
      "isDefault" : false,
      "preset" : {
        "capabilities" : {
          "toolCallingEnabled" : false
        },
        "inference" : {
          "repeatPenalty" : 1.0,
          "temperature" : 1.0,
          "topP" : 1.0
        }
      }
