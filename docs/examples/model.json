      "/temperature" : {
        "label" : "Temperature",
        "widget" : "NUMBER",
        "step" : "sampling",
        "section" : "sampling",
        "order" : 10,
        "access" : {
          "create" : "EDITABLE",
          "edit" : "EDITABLE",
          "view" : "READ_ONLY"
