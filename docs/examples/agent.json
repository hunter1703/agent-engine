                  "type" : "number"
                },
                "stage" : {
                  "enum" : [ "INPUT", "TOOL", "OUTPUT" ],
                  "type" : "string"
                },
                "toolNames" : {
                  "items" : {
                    "type" : "string"
                  },
                  "type" : "array"
                },
                "type" : {
                  "enum" : [ "TEXT_CONTENT", "TOOL_SAFETY", "RELEVANCE" ],
