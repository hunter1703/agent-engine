{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "finalAnswer": { "type": "string" },
    "toolRequests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "intent": { "type": "string" }
        },
        "required": ["name", "args"]
      }
    }
  },
  "anyOf": [
    { "required": ["finalAnswer"], "not": { "required": ["toolRequests"] } },
    { "required": ["toolRequests"], "not": { "required": ["finalAnswer"] } }
  ]
}
