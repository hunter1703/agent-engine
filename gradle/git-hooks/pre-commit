#!/bin/sh
# Spotless pre-commit hook
# Automatically formats staged Java files before commit

echo "Running Spotless code formatter..."

# Get the list of staged Java files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.java$')

if [ -z "$STAGED_FILES" ]; then
    echo "No Java files staged for commit. Skipping Spotless."
    exit 0
fi

# Run Spotless apply on the entire project
./gradlew spotlessApply --quiet

if [ $? -ne 0 ]; then
    echo "❌ Spotless formatting failed. Please fix the issues and try again."
    exit 1
fi

# Re-stage the formatted files
echo "$STAGED_FILES" | while read -r file; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

echo "✅ Code formatted successfully with Spotless."
exit 0
