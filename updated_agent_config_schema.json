{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentengine.com/schemas/agent-config.json",
  "title": "Agent Configuration Schema",
  "description": "Schema for configuring an agent in the Agent Engine",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Type of the agent configuration",
      "enum": [
        "default"
      ],
      "default": "default"
    },
    "id": {
      "type": "string",
      "description": "Unique identifier for the agent (maps to MongoDB _id)",
      "minLength": 1,
      "maxLength": 255
    },
    "name": {
      "type": "string",
      "description": "Display name of the agent",
      "maxLength": 255
    },
    "description": {
      "type": "string",
      "description": "Description of the agent",
      "maxLength": 1000
    },
    "avatar": {
      "type": "string",
      "description": "URL or path to the agent's avatar image",
      "maxLength": 500
    },
    "model": {
      "$ref": "#/$defs/agentModelConfig"
    },
    "sessionStore": {
      "$ref": "#/$defs/sessionServiceConfig"
    }
  },
  "required": [
    "id",
    "model"
  ],
  "additionalProperties": false,
  "$defs": {
    "agentModelConfig": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "description": "Identifier for the reasoning model used by the agent",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "description": "Name of the agent model",
          "minLength": 1,
          "maxLength": 255
        },
        "role": {
          "type": "string",
          "description": "Unique role of the model within the agent",
          "maxLength": 255
        },
        "systemPrompt": {
          "type": "string",
          "description": "System prompt for the agent",
          "minLength": 1
        },
        "contextManagerConfig": {
          "$ref": "#/$defs/contextManagerConfig"
        },
        "tools": {
          "$ref": "#/$defs/toolsConfig"
        }
      },
      "required": [
        "modelId",
        "name",
        "systemPrompt"
      ],
      "additionalProperties": false
    },
    "contextManagerConfig": {
      "oneOf": [
        {
          "$ref": "#/$defs/lastNContextManagerConfig"
        }
      ]
    },
    "lastNContextManagerConfig": {
      "type": "object",
      "properties": {
        "type": {
          "const": "last_n",
          "description": "Type of context manager - keeps last N interactions"
        },
        "keepLast": {
          "type": "integer",
          "description": "Number of last interactions to keep in context",
          "minimum": 1,
          "maximum": 1000,
          "default": 24
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "toolsConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "description": "List of enabled tool IDs. Use 'ALL' to enable every tool; omit or leave empty to disable tools.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "configs": {
          "type": "object",
          "description": "Configuration map for individual tools",
          "additionalProperties": {
            "type": "object",
            "description": "Configuration parameters for a specific tool",
            "additionalProperties": true
          }
        },
        "standardTools": {
          "type": "array",
          "description": "List of standard tools available to the agent",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      },
      "additionalProperties": false
    },
    "sessionServiceConfig": {
      "oneOf": [
        {
          "$ref": "#/$defs/inMemorySessionServiceConfig"
        }
      ]
    },
    "inMemorySessionServiceConfig": {
      "type": "object",
      "properties": {
        "type": {
          "const": "memory",
          "description": "Type of session store - in-memory storage"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  }
}
