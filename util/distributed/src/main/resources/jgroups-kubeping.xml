<config xmlns="urn:org:jgroups" 
        xmlns:xsi="http://w3.org/2001/XMLSchema-instance" 
        xsi:schemaLocation="urn:org:jgroups http://jgroups.org/schema/jgroups-5.3.xsd">
    
    <!-- 1. Network Bindings -->
    <TCP bind_port="7800" 
         recv_buf_size="130k" 
         send_buf_size="130k"
         thread_pool.min_threads="2"
         thread_pool.max_threads="8"
         thread_pool.keep_alive_time="5000"/>
    
    <!-- 2. Kubernetes Pod Discovery via Kube-API -->
    <!-- It automatically looks for pods in the same namespace containing a matching label -->
    <kubernetes.KUBE_PING 
        namespace="${KUBERNETES_NAMESPACE:default}"
        labels="${JGROUPS_CLUSTER_LABEL:app=agent-engine}"/>
    
    <!-- 3. Failure Detection (Heartbeats) -->
    <FD_ALL3 timeout="8000" interval="2000"/>
    <VERIFY_SUSPECT3 timeout="1500"/>
    
    <!-- 4. Reliable Transmission Layers -->
    <pbcast.NAKACK2 xmit_interval="200"/>
    <UNICAST3 xmit_interval="200"/>
    <pbcast.STABLE desired_avg_gossip="50000" max_bytes="4M"/>
    
    <!-- 5. Group Membership & Distributed Synchronization Services -->
    <pbcast.GMS join_timeout="3000"/>
    <CENTRAL_LOCK/>
</config>
