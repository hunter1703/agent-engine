{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Agent Configuration",
    "type": "object",
    "required": [
      "id",
      "name",
      "type",
      "model"
    ],
    "properties": {
      "id": {
        "type": "string",
        "title": "Agent ID",
        "description": "Unique identifier used to reference this agent in configs and APIs.",
        "help": "support-assistant (kebab-case identifier)."
      },
      "name": {
        "type": "string",
        "title": "Agent Name",
        "description": "Display name shown in UIs."
      },
      "description": {
        "type": "string",
        "title": "Agent Description",
        "description": "Long-form summary of the agent's role and scope."
      },
      "type": {
        "type": "string",
        "title": "Agent Type",
        "enum": [
          "default"
        ],
        "default": "default",
        "description": "Agent implementation type. Currently only `default`."
      },
      "model": {
        "$ref": "#/$defs/AgentModelConfig",
        "title": "Model Configuration",
        "description": "Language model configuration for this agent.",
        "help": "Set `modelId` to an entry from `model.json`."
      }
    },
    "$defs": {
      "SessionServiceConfig": {
        "type": "object",
        "title": "Session Service Configuration",
        "description": "Configuration options for storing conversation sessions.",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "memory": "#/$defs/InMemorySessionServiceConfig",
            "mongodb": "#/$defs/MongoSessionServiceConfig"
          }
        },
        "oneOf": [
          {
            "$ref": "#/$defs/InMemorySessionServiceConfig"
          },
          {
            "$ref": "#/$defs/MongoSessionServiceConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "title": "Session Store Type",
            "description": "Session storage type.",
            "default": "mongodb",
            "enum": [
              "mongodb"
            ],
            "help": "Use `memory` for ephemeral sessions or `mongodb` for persistence."
          }
        },
        "required": [
          "type"
        ]
      },
      "InMemorySessionServiceConfig": {
        "type": "object",
        "title": "In-Memory Session Configuration",
        "description": "Configuration for storing sessions in memory.",
        "allOf": [
          {
            "$ref": "#/$defs/SessionServiceConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "memory",
            "title": "Session Store Type",
            "description": "In-memory session storage."
          }
        },
        "required": [
          "type"
        ]
      },
      "MongoSessionServiceConfig": {
        "type": "object",
        "title": "MongoDB Session Configuration",
        "description": "Configuration for storing sessions in MongoDB.",
        "allOf": [
          {
            "$ref": "#/$defs/SessionServiceConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "mongodb",
            "title": "Session Store Type",
            "description": "MongoDB session storage."
          },
          "connectionString": {
            "type": "string",
            "title": "MongoDB Connection String",
            "description": "MongoDB connection string for session storage.",
            "help": "mongodb://localhost:27017/agent"
          }
        },
        "required": [
          "type"
        ]
      },
      "AgentModelConfig": {
        "type": "object",
        "title": "Agent Model Configuration",
        "required": [
          "modelId"
        ],
        "properties": {
          "modelId": {
            "type": "string",
            "title": "Model ID",
            "description": "Model config ID to use for this agent.",
            "help": "Model entry ID (`ollama-llama3`)."
          },
          "systemPrompt": {
            "type": "string",
            "title": "System Prompt",
            "description": "Initial instructions prepended to each conversation.",
            "help": "You are a helpful support agent."
          },
          "role": {
            "type": "string",
            "title": "Message Role",
            "description": "Role to assign to the system prompt message.",
            "help": "Common values: `system`, `user`, `assistant`."
          },
          "contextManagerConfig": {
            "$ref": "#/$defs/ContextManagerConfig",
            "title": "Context Manager",
            "description": "Conversation context management configuration.",
            "help": "{ \"type\": \"last_n\", \"keepLast\": 24 }"
          }
        }
      },
      "ContextManagerConfig": {
        "type": "object",
        "title": "Context Manager Configuration",
        "description": "Configuration for managing conversation context.",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "last_n": "#/$defs/LastNContextManagerConfig"
          }
        },
        "oneOf": [
          {
            "$ref": "#/$defs/LastNContextManagerConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "title": "Context Manager Type",
            "description": "Context management strategy (for example, `last_n` keeps recent messages).",
            "enum": [
              "last_n"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "LastNContextManagerConfig": {
        "type": "object",
        "title": "Recent Messages Context Configuration",
        "description": "Configuration for keeping the last N messages in context.",
        "allOf": [
          {
            "$ref": "#/$defs/ContextManagerConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "last_n",
            "title": "Context Manager Type",
            "description": "Keep only the most recent N messages."
          },
          "keepLast": {
            "type": "integer",
            "minimum": 1,
            "default": 24,
            "title": "Messages to Keep",
            "description": "Number of recent messages to keep in context."
          }
        },
        "required": [
          "type",
          "keepLast"
        ]
      }
    }
  },
  "layout": {
    "model": {
      "modelId": {
        "widget": "LOOKUP",
        "lookupRequest": {
          "url": "/catalog/list",
          "method": "POST",
          "body": {
            "assetType": "model"
          }
        }
      }
    }
  }
}
