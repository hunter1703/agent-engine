{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Model Configuration",
    "type": "object",
    "required": [
      "id",
      "name",
      "type",
      "model"
    ],
    "properties": {
      "id": {
        "type": "string",
        "title": "Model ID",
        "description": "Unique identifier referenced by agent model configs."
      },
      "name": {
        "type": "string",
        "title": "Model Name",
        "description": "Display name shown in UIs."
      },
      "type": {
        "type": "string",
        "title": "Provider Type",
        "enum": [
          "ollama",
          "open_ai_compatible",
          "gemini"
        ],
        "description": "Provider backend type for this model configuration."
      },
      "model": {
        "type": "string",
        "title": "Model Identifier",
        "description": "Provider-specific model identifier.",
        "help": "gemini-1.5-flash-latest, llama3"
      },
      "temperature": {
        "type": "number",
        "format": "float",
        "minimum": 0.0,
        "maximum": 2.0,
        "default": 0.7,
        "title": "Temperature",
        "description": "Sampling temperature that controls randomness.",
        "help": "Common values range from `0.2` (focused) to `1.0` (creative)."
      },
      "numPredict": {
        "type": "integer",
        "minimum": 1,
        "title": "Max Tokens to Generate",
        "description": "Maximum tokens to generate per response.",
        "help": "Leave unset to use the provider default."
      },
      "topK": {
        "type": "integer",
        "minimum": 0,
        "title": "Top-K",
        "description": "Limits sampling to the K most probable tokens."
      },
      "topP": {
        "type": "number",
        "format": "float",
        "minimum": 0.0,
        "maximum": 1.0,
        "title": "Top-P",
        "description": "Nucleus sampling threshold for cumulative token probability."
      },
      "repeatPenalty": {
        "type": "number",
        "format": "float",
        "minimum": 0.0,
        "title": "Repeat Penalty",
        "description": "Penalty applied to repeated tokens to discourage repetition."
      },
      "stopTokens": {
        "type": "array",
        "title": "Stop Tokens",
        "items": {
          "type": "string"
        },
        "description": "Tokens that stop generation when emitted.",
        "help": "[\"</s>\"]"
      },
      "instructions": {
        "type": "string",
        "title": "Model Instructions",
        "description": "Additional model-level guidance appended to system instructions.",
        "help": "Use for model-specific behavioral guidance."
      },
      "responseFormat": {
        "type": "string",
        "title": "Response Format",
        "description": "Desired response format when supported by the provider.",
        "help": "json"
      },
      "toolCallingEnabled": {
        "type": "boolean",
        "default": false,
        "title": "Enable Tool Calling",
        "description": "Enable tool calling for this model configuration when supported."
      },
      "toolCallingSupported": {
        "type": "boolean",
        "title": "Tool Calling Supported",
        "description": "Read-only flag indicating provider support for tool calling."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "gemini"
            }
          }
        },
        "then": {
          "required": [
            "apiKey"
          ],
          "properties": {
            "apiKey": {
              "title": "API Key",
              "description": "API key required for Gemini models."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "open_ai_compatible"
            }
          }
        },
        "then": {
          "properties": {
            "apiKey": {
              "title": "API Key",
              "description": "API key for OpenAI compatible providers; optional for local servers."
            },
            "baseUrl": {
              "title": "Base URL",
              "description": "Base URL for OpenAI compatible API endpoint.",
              "help": "https://api.openai.com/v1"
            },
            "serverCommand": {
              "title": "Server Command",
              "description": "Command to start a local OpenAI compatible server."
            },
            "serverArgs": {
              "title": "Server Arguments",
              "description": "Arguments passed to the local server command."
            },
            "serverWorkdir": {
              "title": "Server Working Directory",
              "description": "Working directory for the local server command."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "ollama"
            }
          }
        },
        "then": {
          "properties": {
            "baseUrl": {
              "title": "Base URL",
              "description": "Ollama API base URL.",
              "default": "http://localhost:11434"
            }
          }
        }
      }
    ]
  },
  "layout": {
    "version": "1.0",
    "mode": "wizard",
    "steps": [
      {
        "id": "identity",
        "title": "Identity",
        "description": "Core model identity and provider.",
        "sections": [
          "identity"
        ]
      },
      {
        "id": "sampling",
        "title": "Sampling",
        "description": "Generation and sampling controls.",
        "sections": [
          "sampling"
        ]
      },
      {
        "id": "integration",
        "title": "Integration",
        "description": "Provider connectivity and advanced options.",
        "sections": [
          "integration"
        ]
      }
    ],
    "sections": [
      {
        "id": "identity",
        "title": "Identity",
        "description": "Model id, display name, provider type and model identifier.",
        "schemaPointer": "#",
        "fields": [
          "id",
          "name",
          "type",
          "model"
        ]
      },
      {
        "id": "sampling",
        "title": "Sampling",
        "description": "Temperature and token selection parameters.",
        "schemaPointer": "#",
        "fields": [
          "temperature",
          "numPredict",
          "topK",
          "topP",
          "repeatPenalty",
          "stopTokens"
        ]
      },
      {
        "id": "integration",
        "title": "Provider Integration",
        "description": "API keys, endpoints and runtime server options.",
        "schemaPointer": "#",
        "fields": [
          "apiKey",
          "baseUrl",
          "serverCommand",
          "serverArgs",
          "serverWorkdir",
          "instructions",
          "responseFormat",
          "toolCallingEnabled",
          "toolCallingSupported"
        ]
      }
    ],
    "fields": {
      "instructions": {
        "widget": "TEXTAREA",
        "rows": 4
      },
      "serverArgs": {
        "widget": "TEXTAREA",
        "rows": 3
      }
    },
    "presets": [
      {
        "id": "balanced",
        "label": "Balanced",
        "description": "General purpose default profile.",
        "isDefault": true,
        "patch": {
          "temperature": 0.7,
          "topP": 0.95,
          "repeatPenalty": 1.0,
          "toolCallingEnabled": false
        }
      },
      {
        "id": "focused",
        "label": "Focused",
        "description": "Lower randomness for deterministic answers.",
        "patch": {
          "temperature": 0.2,
          "topP": 0.8,
          "repeatPenalty": 1.1,
          "toolCallingEnabled": true
        }
      },
      {
        "id": "creative",
        "label": "Creative",
        "description": "Higher diversity and broader token exploration.",
        "patch": {
          "temperature": 1.0,
          "topP": 1.0,
          "repeatPenalty": 1.0,
          "toolCallingEnabled": false
        }
      }
    ],
    "validations": [],
    "actions": {
      "saveLabel": "Save Model",
      "cancelLabel": "Cancel",
      "nextLabel": "Continue",
      "backLabel": "Back",
      "unsavedChangesWarning": "You have unsaved builder changes. Leaving now will discard them."
    }
  }
}
