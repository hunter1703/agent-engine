{
  "schema": {
    "title": "Agent Configuration",
    "type": "object",
    "required": [
      "id",
      "name",
      "type"
    ],
    "properties": {
      "id": {
        "type": "string",
        "title": "Agent ID",
        "description": "Unique identifier used to reference this agent in configs and APIs."
      },
      "name": {
        "type": "string",
        "title": "Agent Name",
        "description": "Display name shown in UIs."
      },
      "type": {
        "type": "string",
        "title": "Agent Type",
        "enum": [
          "default",
          "orchestrator"
        ],
        "default": "default",
        "description": "Agent implementation type."
      },
      "description": {
        "type": "string",
        "title": "Description"
      },
      "avatar": {
        "type": "string",
        "title": "Avatar"
      },
      "modelId": {
        "type": "string",
        "title": "Model ID",
        "description": "Primary model used for this agent. Required for default agents and orchestrator mode TRANSFER."
      },
      "systemPrompt": {
        "type": "string",
        "title": "System Prompt",
        "description": "Behavioral instruction for the agent."
      },
      "tools": {
        "type": "array",
        "title": "Tools",
        "items": {
          "$ref": "#/$defs/ToolsConfig"
        }
      },
      "contextStrategy": {
        "$ref": "#/$defs/ContextStrategyConfig",
        "title": "Context Strategy"
      },
      "subAgentIds": {
        "type": "array",
        "title": "Sub Agents",
        "description": "Sub-agent IDs available for native transfer routing.",
        "items": {
          "type": "string"
        }
      },
      "orchestrationMode": {
        "$ref": "#/$defs/OrchestrationMode",
        "title": "Orchestration Mode",
        "description": "Orchestrator runtime mode: TRANSFER, SEQUENTIAL, or PARALLEL."
      },
      "parallel": {
        "$ref": "#/$defs/OrchestratorParallelConfig",
        "title": "Parallel Orchestration"
      },
      "sessionStore": {
        "$ref": "#/$defs/SessionServiceConfig",
        "title": "Session Store"
      },
      "runtime": {
        "$ref": "#/$defs/AgentRuntimeConfig",
        "title": "Runtime"
      },
      "guardrails": {
        "$ref": "#/$defs/GuardrailsConfig",
        "title": "Guardrails"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "default"
            }
          },
          "required": [
            "type"
          ]
        },
        "then": {
          "required": [
            "modelId"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "orchestrator"
            }
          },
          "required": [
            "type"
          ]
        },
        "then": {
          "allOf": [
            {
              "if": {
                "not": {
                  "properties": {
                    "orchestrationMode": {
                      "enum": [
                        "SEQUENTIAL",
                        "PARALLEL"
                      ]
                    }
                  },
                  "required": [
                    "orchestrationMode"
                  ]
                }
              },
              "then": {
                "required": [
                  "modelId"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "orchestrationMode": {
                    "enum": [
                      "SEQUENTIAL",
                      "PARALLEL"
                    ]
                  }
                },
                "required": [
                  "orchestrationMode"
                ]
              },
              "then": {
                "required": [
                  "subAgentIds"
                ],
                "properties": {
                  "subAgentIds": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      },
      {
        "if": {
          "not": {
            "properties": {
              "type": {
                "const": "orchestrator"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "then": {
          "properties": {
            "subAgentIds": {
              "maxItems": 0
            }
          }
        }
      }
    ],
    "$defs": {
      "SessionServiceConfig": {
        "type": "object",
        "title": "Session Service Configuration",
        "description": "Configuration options for storing conversation sessions.",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "memory": "#/$defs/InMemorySessionServiceConfig",
            "mongodb": "#/$defs/MongoSessionServiceConfig"
          }
        },
        "oneOf": [
          {
            "$ref": "#/$defs/InMemorySessionServiceConfig"
          },
          {
            "$ref": "#/$defs/MongoSessionServiceConfig"
          }
        ],
        "required": [
          "type"
        ]
      },
      "InMemorySessionServiceConfig": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/SessionServiceConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "memory"
          }
        },
        "required": [
          "type"
        ]
      },
      "MongoSessionServiceConfig": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/SessionServiceConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "mongodb"
          },
          "connectionString": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      },
      "AgentRuntimeConfig": {
        "type": "object",
        "properties": {
          "resumable": {
            "type": "boolean",
            "default": true,
            "description": "When true, paused executions can be resumed."
          },
          "maxSteps": {
            "type": "integer",
            "minimum": 1,
            "default": 50,
            "description": "Maximum model turns per invocation."
          }
        }
      },
      "OrchestrationMode": {
        "type": "string",
        "enum": [
          "UNKNOWN",
          "TRANSFER",
          "SEQUENTIAL",
          "PARALLEL"
        ],
        "default": "TRANSFER"
      },
      "ParallelAggregationPolicy": {
        "type": "string",
        "enum": [
          "UNKNOWN",
          "CONCATENATE",
          "BEST_EFFORT",
          "MAJORITY_VOTE"
        ],
        "default": "CONCATENATE"
      },
      "ParallelStoppingPolicy": {
        "type": "string",
        "enum": [
          "UNKNOWN",
          "ALL_COMPLETE",
          "FIRST_SUCCESS",
          "QUORUM"
        ],
        "default": "ALL_COMPLETE"
      },
      "OrchestratorParallelConfig": {
        "type": "object",
        "properties": {
          "aggregationPolicy": {
            "$ref": "#/$defs/ParallelAggregationPolicy",
            "description": "Parallel aggregation policy. Current runtime supports CONCATENATE only."
          },
          "stoppingPolicy": {
            "$ref": "#/$defs/ParallelStoppingPolicy",
            "description": "Parallel stopping policy. Current runtime supports ALL_COMPLETE only."
          },
          "quorum": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Reserved for quorum stopping. Current runtime requires quorum=1."
          }
        }
      },
      "ToolsConfig": {
        "type": "object",
        "required": [
          "toolName"
        ],
        "properties": {
          "toolName": {
            "type": "string"
          },
          "configs": {
            "type": "object"
          }
        }
      },
      "ContextStrategyConfig": {
        "type": "object",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "compaction": "#/$defs/CompactionContextStrategyConfig",
            "last_n": "#/$defs/LastNContextStrategyConfig",
            "none": "#/$defs/NoneContextStrategyConfig"
          }
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CompactionContextStrategyConfig"
          },
          {
            "$ref": "#/$defs/LastNContextStrategyConfig"
          },
          {
            "$ref": "#/$defs/NoneContextStrategyConfig"
          }
        ],
        "required": [
          "type"
        ]
      },
      "CompactionContextStrategyConfig": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/ContextStrategyConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "compaction"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "tokenThreshold": {
            "type": "integer",
            "minimum": 1,
            "default": 4096
          },
          "eventRetentionSize": {
            "type": "integer",
            "minimum": 1,
            "default": 50
          },
          "overlapSize": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "modelId": {
            "type": "string",
            "description": "Optional compaction model ID. Falls back to infra default compaction model."
          },
          "promptTemplate": {
            "type": "string",
            "description": "Optional custom summarizer prompt used by the runtime LlmEventSummarizer."
          }
        },
        "required": [
          "type"
        ]
      },
      "LastNContextStrategyConfig": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/ContextStrategyConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "last_n"
          },
          "keepLastTokens": {
            "type": "integer",
            "minimum": 1,
            "default": 1024
          }
        },
        "required": [
          "type",
          "keepLastTokens"
        ]
      },
      "NoneContextStrategyConfig": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/ContextStrategyConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "none"
          }
        },
        "required": [
          "type"
        ]
      },
      "GuardrailsConfig": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "executionMode": {
            "type": "string",
            "enum": [
              "SYNC",
              "OPTIMISTIC"
            ],
            "default": "SYNC"
          },
          "defaultOnError": {
            "type": "string",
            "enum": [
              "FAIL_OPEN",
              "FAIL_CLOSED"
            ],
            "default": "FAIL_CLOSED"
          },
          "rules": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/TextContentGuardrailRule"
                },
                {
                  "$ref": "#/$defs/ToolSafetyGuardrailRule"
                },
                {
                  "$ref": "#/$defs/OutputRelevanceGuardrailRule"
                }
              ]
            }
          }
        }
      },
      "GuardrailRule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "TEXT_CONTENT",
              "TOOL_SAFETY",
              "RELEVANCE"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "INPUT",
              "TOOL",
              "OUTPUT"
            ]
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "action": {
            "type": "string",
            "enum": [
              "ALLOW",
              "WARN",
              "BLOCK",
              "ESCALATE"
            ],
            "default": "WARN"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "TextContentGuardrailRule": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/GuardrailRule"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "TEXT_CONTENT"
          },
          "maxTextLength": {
            "type": "integer",
            "minimum": 1
          },
          "blockedPatterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ToolSafetyGuardrailRule": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/GuardrailRule"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "TOOL_SAFETY"
          },
          "minToolRisk": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ],
            "default": "HIGH"
          },
          "toolNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OutputRelevanceGuardrailRule": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/GuardrailRule"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "RELEVANCE"
          },
          "evaluatorModelId": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "STEER_THEN_BLOCK",
              "STEER_ONLY",
              "STEER_THEN_ALLOW"
            ],
            "default": "STEER_THEN_BLOCK"
          },
          "maxSteeringRetries": {
            "type": "integer",
            "minimum": 0,
            "default": 3
          },
          "relevanceThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.2
          },
          "anchorStrategy": {
            "type": "string",
            "enum": [
              "RECENT_USER",
              "LATEST_USER_AND_PLAN"
            ],
            "default": "LATEST_USER_AND_PLAN"
          },
          "recency": {
            "type": "integer",
            "minimum": 1,
            "default": 5
          }
        }
      }
    }
  },
  "layout": {
    "version": "1.0",
    "mode": "wizard",
    "steps": [
      {
        "id": "identity",
        "title": "Identity",
        "sections": [
          "identity"
        ]
      },
      {
        "id": "model",
        "title": "Model",
        "sections": [
          "model_core",
          "context"
        ]
      },
      {
        "id": "runtime",
        "title": "Runtime",
        "sections": [
          "runtime"
        ]
      },
      {
        "id": "guardrails",
        "title": "Guardrails",
        "sections": [
          "guardrails_global",
          "guardrails_rules"
        ]
      }
    ],
    "sections": [
      {
        "id": "identity",
        "title": "Identity",
        "schemaPointer": "#",
        "fields": [
          "id",
          "name",
          "type",
          "description",
          "avatar",
          "orchestrationMode",
          "parallel",
          "subAgentIds"
        ]
      },
      {
        "id": "model_core",
        "title": "Model",
        "dataPath": "",
        "schemaPointer": "#",
        "layoutPath": "",
        "fields": [
          "modelId",
          "systemPrompt",
          "tools"
        ]
      },
      {
        "id": "context",
        "title": "Context Strategy",
        "dataPath": "contextStrategy",
        "schemaPointer": "#/$defs/ContextStrategyConfig",
        "layoutPath": "contextStrategy"
      },
      {
        "id": "runtime",
        "title": "Runtime",
        "dataPath": "runtime",
        "schemaPointer": "#/$defs/AgentRuntimeConfig",
        "layoutPath": "runtime",
        "fields": [
          "resumable",
          "maxSteps"
        ]
      },
      {
        "id": "guardrails_global",
        "title": "Guardrail Runtime",
        "dataPath": "guardrails",
        "schemaPointer": "#/$defs/GuardrailsConfig",
        "layoutPath": "guardrails",
        "fields": [
          "enabled",
          "executionMode",
          "defaultOnError"
        ]
      },
      {
        "id": "guardrails_rules",
        "title": "Guardrail Rules",
        "dataPath": "guardrails",
        "schemaPointer": "#/$defs/GuardrailsConfig",
        "layoutPath": "guardrails",
        "fields": [
          "rules"
        ]
      }
    ],
    "fields": {
      "modelId": {
        "widget": "LOOKUP",
        "lookupRequest": {
          "url": "/catalog/list",
          "method": "POST",
          "body": {
            "assetType": "model"
          }
        }
      },
      "systemPrompt": {
        "widget": "TEXTAREA",
        "rows": 6
      },
      "contextStrategy": {
        "modelId": {
          "widget": "LOOKUP",
          "lookupRequest": {
            "url": "/catalog/list",
            "method": "POST",
            "body": {
              "assetType": "model"
            }
          }
        },
        "promptTemplate": {
          "widget": "TEXTAREA",
          "rows": 4
        }
      },
      "tools": {
        "items": {
          "toolName": {
            "widget": "LOOKUP",
            "lookupRequest": {
              "url": "/catalog/list",
              "method": "POST",
              "body": {
                "assetType": "tool"
              }
            }
          },
          "configs": {
            "widget": "SCHEMA_LOOKUP",
            "dependencies": [
              "$toolName"
            ],
            "lookupRequest": {
              "url": "/schemas",
              "method": "POST",
              "body": {
                "assetType": "tool_configs",
                "assetId": "$toolName",
                "agentId": "$.id"
              }
            }
          }
        }
      },
      "guardrails": {
        "rules": {
          "items": {
            "type": {
              "widget": "SELECT"
            },
            "message": {
              "widget": "TEXTAREA",
              "rows": 2
            },
            "evaluatorModelId": {
              "widget": "LOOKUP",
              "lookupRequest": {
                "url": "/catalog/list",
                "method": "POST",
                "body": {
                  "assetType": "model"
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "saveLabel": "Save Agent",
      "cancelLabel": "Cancel",
      "nextLabel": "Continue",
      "backLabel": "Back",
      "unsavedChangesWarning": "You have unsaved builder changes. Leaving now will discard them."
    }
  }
}
