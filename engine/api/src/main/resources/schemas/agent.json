{
  "schema": {
    "title": "Agent Configuration",
    "type": "object",
    "required": [
      "id",
      "name",
      "type",
      "model"
    ],
    "properties": {
      "id": {
        "type": "string",
        "title": "Agent ID",
        "description": "Unique identifier used to reference this agent in configs and APIs.",
        "help": "support-assistant (kebab-case identifier)."
      },
      "name": {
        "type": "string",
        "title": "Agent Name",
        "description": "Display name shown in UIs."
      },
      "type": {
        "type": "string",
        "title": "Agent Type",
        "enum": [
          "default",
          "story",
          "orchestrator",
          "worker"
        ],
        "default": "default",
        "description": "Agent implementation type.",
        "help": "`default` for standard agents, `story` for story flow, `orchestrator` for manager agents, `worker` for delegated specialists."
      },
      "model": {
        "$ref": "#/$defs/AgentModelConfig",
        "title": "Model Configuration",
        "description": "Language model configuration for this agent."
      },
      "routingModelId": {
        "type": "string",
        "title": "Routing Model ID",
        "description": "Model config ID used for flow routing decisions. If omitted, the agent's main model is used.",
        "help": "Use a lightweight model (e.g. `ollama-llama3`) to keep routing fast."
      },
      "routingHistorySize": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "title": "Routing History Size",
        "description": "Number of recent session events passed to the routing model. 0 = only the last user message (default); positive = last N events."
      },
      "guardrails": {
        "$ref": "#/$defs/GuardrailsConfig",
        "title": "Guardrails",
        "description": "Guardrail and on-topic policy controls."
      },
      "outputEvaluation": {
        "$ref": "#/$defs/OutputEvaluationConfig",
        "title": "Output Evaluation",
        "description": "Output evaluation retry loop configuration."
      }
    },
    "$defs": {
      "SessionServiceConfig": {
        "type": "object",
        "title": "Session Service Configuration",
        "description": "Configuration options for storing conversation sessions.",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "memory": "#/$defs/InMemorySessionServiceConfig",
            "mongodb": "#/$defs/MongoSessionServiceConfig"
          }
        },
        "oneOf": [
          {
            "$ref": "#/$defs/InMemorySessionServiceConfig"
          },
          {
            "$ref": "#/$defs/MongoSessionServiceConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "title": "Session Store Type",
            "description": "Session storage type.",
            "default": "mongodb",
            "enum": [
              "mongodb"
            ],
            "help": "Use `memory` for ephemeral sessions or `mongodb` for persistence."
          }
        },
        "required": [
          "type"
        ]
      },
      "InMemorySessionServiceConfig": {
        "type": "object",
        "title": "In-Memory Session Configuration",
        "description": "Configuration for storing sessions in memory.",
        "allOf": [
          {
            "$ref": "#/$defs/SessionServiceConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "memory",
            "title": "Session Store Type",
            "description": "In-memory session storage."
          }
        },
        "required": [
          "type"
        ]
      },
      "MongoSessionServiceConfig": {
        "type": "object",
        "title": "MongoDB Session Configuration",
        "description": "Configuration for storing sessions in MongoDB.",
        "allOf": [
          {
            "$ref": "#/$defs/SessionServiceConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "mongodb",
            "title": "Session Store Type",
            "description": "MongoDB session storage."
          },
          "connectionString": {
            "type": "string",
            "title": "MongoDB Connection String",
            "description": "MongoDB connection string for session storage.",
            "help": "mongodb://localhost:27017/agent"
          }
        },
        "required": [
          "type"
        ]
      },
      "AgentModelConfig": {
        "type": "object",
        "title": "Agent Model Configuration",
        "required": [
          "modelId",
          "systemPrompt"
        ],
        "properties": {
          "modelId": {
            "type": "string",
            "title": "Model ID",
            "description": "Model config ID to use for this agent.",
            "help": "Model entry ID (`ollama-llama3`)."
          },
          "systemPrompt": {
            "type": "string",
            "title": "System Prompt",
            "description": "Initial instructions prepended to each conversation.",
            "help": "You are a helpful support agent."
          },
          "role": {
            "type": "string",
            "title": "Message Role",
            "description": "Role to assign to the system prompt message.",
            "help": "Common values: `system`, `user`, `assistant`."
          },
          "contextManagerConfig": {
            "$ref": "#/$defs/ContextManagerConfig",
            "title": "Context Manager",
            "description": "Conversation context management configuration."
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ToolsConfig"
            },
            "title": "Tools",
            "description": "List of tools enabled for this model."
          }
        }
      },
      "ToolsConfig": {
        "type": "object",
        "title": "Tool Configuration",
        "required": [
          "toolName"
        ],
        "properties": {
          "toolName": {
            "type": "string",
            "title": "Tool Name",
            "description": "Name of the tool.",
            "help": "Select a tool from the list"
          },
          "configs": {
            "type": "object",
            "title": "Tool Configuration Params"
          }
        }
      },
      "GuardrailsConfig": {
        "type": "object",
        "title": "Guardrails Configuration",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable or disable guardrail checks."
          },
          "executionMode": {
            "type": "string",
            "enum": [
              "SYNC",
              "OPTIMISTIC"
            ],
            "default": "SYNC",
            "description": "Guardrail execution mode.",
            "help": "`SYNC` evaluates before execution (safer). `OPTIMISTIC` runs concurrently and cancels on block (lower latency)."
          },
          "defaultOnError": {
            "type": "string",
            "enum": [
              "FAIL_OPEN",
              "FAIL_CLOSED"
            ],
            "default": "FAIL_CLOSED",
            "description": "Fallback behavior when guardrail evaluation fails.",
            "help": "`FAIL_CLOSED` blocks on guardrail runtime errors (recommended). `FAIL_OPEN` allows execution on errors."
          },
          "rules": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/InputRulesGuardrailRuleConfig"
                },
                {
                  "$ref": "#/$defs/OutputRulesGuardrailRuleConfig"
                },
                {
                  "$ref": "#/$defs/ToolRiskGuardrailRuleConfig"
                },
                {
                  "$ref": "#/$defs/OnTopicGuardrailRuleConfig"
                }
              ]
            }
          },
          "topicControl": {
            "$ref": "#/$defs/TopicControlConfig"
          }
        }
      },
      "GuardrailRuleConfig": {
        "type": "object",
        "title": "Guardrail Rule",
        "description": "Common guardrail rule fields.",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "INPUT_RULES",
              "OUTPUT_RULES",
              "TOOL_RISK",
              "ON_TOPIC"
            ],
            "description": "Guardrail rule type used to select the rule provider.",
            "help": "`type` is required for strict typed rule deserialization."
          },
          "stage": {
            "type": "string",
            "enum": [
              "INPUT",
              "TOOL",
              "OUTPUT"
            ],
            "description": "Rule execution stage. This should align with the selected rule type."
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "action": {
            "type": "string",
            "enum": [
              "ALLOW",
              "WARN",
              "BLOCK",
              "ESCALATE"
            ],
            "default": "WARN",
            "description": "Policy action when this rule matches.",
            "help": "`WARN` allows with signal, `BLOCK` stops, `ESCALATE` requests manual intervention."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "InputRulesGuardrailRuleConfig": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/GuardrailRuleConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "INPUT_RULES"
          },
          "maxTextLength": {
            "type": "integer",
            "minimum": 1
          },
          "blockedPatterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OutputRulesGuardrailRuleConfig": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/GuardrailRuleConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "OUTPUT_RULES"
          },
          "maxTextLength": {
            "type": "integer",
            "minimum": 1
          },
          "blockedPatterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ToolRiskGuardrailRuleConfig": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/GuardrailRuleConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "TOOL_RISK"
          },
          "minToolRisk": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ],
            "default": "HIGH",
            "description": "Minimum tool risk level this rule applies to."
          },
          "toolNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OnTopicGuardrailRuleConfig": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/$defs/GuardrailRuleConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "ON_TOPIC"
          }
        }
      },
      "TopicControlConfig": {
        "type": "object",
        "title": "On-topic Control",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "llmEvaluatorEnabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable LLM-based on-topic scoring. Falls back to lexical scoring if evaluator model is unavailable."
          },
          "evaluatorModelId": {
            "type": "string",
            "description": "Optional fast model used for on-topic evaluation. If omitted, evaluator falls back to current agent model."
          },
          "mode": {
            "type": "string",
            "enum": [
              "STEER_THEN_BLOCK",
              "STEER_ONLY",
              "STRICT_BLOCK"
            ],
            "default": "STEER_THEN_BLOCK",
            "help": "`STEER_THEN_BLOCK` retries once then blocks, `STEER_ONLY` never blocks, `STRICT_BLOCK` blocks immediately."
          },
          "maxSteeringRetries": {
            "type": "integer",
            "minimum": 0,
            "default": 1
          },
          "relevanceThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.2
          },
          "anchorStrategy": {
            "type": "string",
            "enum": [
              "LATEST_USER",
              "RECENT_USER",
              "LATEST_USER_AND_PLAN"
            ],
            "default": "LATEST_USER_AND_PLAN",
            "help": "`LATEST_USER` for strict last-turn relevance, `RECENT_USER` for conversational continuity, `LATEST_USER_AND_PLAN` for planning agents."
          }
        }
      },
      "OutputEvaluationConfig": {
        "type": "object",
        "title": "Output Evaluation",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "llmEvaluatorEnabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable LLM-based relevance evaluation (dual-prompt relevance/irrelevance scoring). Falls back to lexical scoring if model is unavailable."
          },
          "evaluatorModelId": {
            "type": "string",
            "description": "Optional fast model used for evaluator scoring. If omitted, evaluator falls back to current agent model."
          },
          "maxRetries": {
            "type": "integer",
            "minimum": 0,
            "default": 2
          },
          "minScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.25
          },
          "stopPolicy": {
            "type": "string",
            "enum": [
              "RETRY_THEN_ALLOW",
              "RETRY_THEN_BLOCK"
            ],
            "default": "RETRY_THEN_ALLOW",
            "help": "After retries are exhausted, `RETRY_THEN_ALLOW` passes latest output; `RETRY_THEN_BLOCK` returns a block message."
          },
          "anchorStrategy": {
            "type": "string",
            "enum": [
              "LATEST_USER",
              "RECENT_USER",
              "LATEST_USER_AND_PLAN"
            ],
            "default": "LATEST_USER_AND_PLAN"
          }
        }
      },
      "ContextManagerConfig": {
        "type": "object",
        "title": "Context Manager Configuration",
        "description": "Configuration for managing conversation context.",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "summarize": "#/$defs/SummarizeContextManagerConfig",
            "last_n": "#/$defs/LastNContextManagerConfig"
          }
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SummarizeContextManagerConfig"
          },
          {
            "$ref": "#/$defs/LastNContextManagerConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "title": "Context Manager Type",
            "description": "Context management strategy (for example, `last_n` keeps recent messages).",
            "enum": [
              "summarize",
              "last_n"
            ],
            "default": "summarize"
          }
        },
        "required": [
          "type"
        ]
      },
      "SummarizeContextManagerConfig": {
        "type": "object",
        "title": "Summarizing Context Configuration",
        "description": "Compacts older context into a persisted summary while keeping recent raw context.",
        "allOf": [
          {
            "$ref": "#/$defs/ContextManagerConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "summarize",
            "title": "Context Manager Type",
            "description": "Summarize older context and keep recent raw messages."
          },
          "triggerTokens": {
            "type": "integer",
            "minimum": 32,
            "default": 4096,
            "title": "Compaction Trigger",
            "description": "Approximate token threshold where compaction starts."
          },
          "recencyTokens": {
            "type": "integer",
            "minimum": 8,
            "default": 1024,
            "title": "Raw Recency Window",
            "description": "Approximate recent tokens to keep unsummarized. Must be lower than triggerTokens."
          },
          "summaryModelId": {
            "type": "string",
            "title": "Summary Model ID",
            "description": "Optional model for compaction summaries. If omitted, infra default summary model is used; then agent model as fallback."
          }
        },
        "required": [
          "type"
        ]
      },
      "LastNContextManagerConfig": {
        "type": "object",
        "title": "Recent Messages Context Configuration",
        "description": "Configuration for keeping the last N tokens in context.",
        "allOf": [
          {
            "$ref": "#/$defs/ContextManagerConfig"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "last_n",
            "title": "Context Manager Type",
            "description": "Keep only the most recent N messages."
          },
          "keepLast": {
            "type": "integer",
            "minimum": 1,
            "default": 1024,
            "title": "Messages to Keep",
            "description": "Number of recent messages to keep in context."
          }
        },
        "required": [
          "type",
          "keepLast"
        ]
      }
    }
  },
  "layout": {
    "routingModelId": {
      "widget": "LOOKUP",
      "lookupRequest": {
        "url": "/catalog/list",
        "method": "POST",
        "body": {
          "assetType": "model"
        }
      }
    },
    "model": {
      "modelId": {
        "widget": "LOOKUP",
        "lookupRequest": {
          "url": "/catalog/list",
          "method": "POST",
          "body": {
            "assetType": "model"
          }
        }
      },
      "tools": {
        "items": {
          "toolName": {
            "widget": "LOOKUP",
            "lookupRequest": {
              "url": "/catalog/list",
              "method": "POST",
              "body": {
                "assetType": "tool"
              }
            }
          },
          "configs": {
            "widget": "SCHEMA_LOOKUP",
            "dependencies": [
              "$toolName"
            ],
            "lookupRequest": {
              "url": "/schemas",
              "method": "POST",
              "body": {
                "assetType": "tool_configs",
                "assetId": "$toolName",
                "agentId": "$.id"
              }
            }
          }
        }
      },
      "systemPrompt": {
        "widget": "TEXTAREA",
        "rows": 6
      }
    }
  }
}
